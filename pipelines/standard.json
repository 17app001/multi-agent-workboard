{
  "id": "standard",
  "description": "標準流程(主導者模式):Claude 出計畫(你核准後才施工)→ codex 池施工(額度用完自動換帳號)→ 跑專案測試 → Claude 審查 → 不過則回修(上限 maxRevisions)。測試指令取專案的 testCommand,沒設定且有 npm test 才跑 npm test,否則略過。",
  "maxRevisions": 3,
  "steps": [
    { "id": "plan", "agent": "claude", "mode": "plan", "output": "plan.md", "gate": "human" },
    { "id": "code", "pool": "codex", "mode": "execute", "input": ["plan.md"] },
    { "id": "test", "type": "command", "command": "{{test}}", "output": "test.txt" },
    { "id": "review", "agent": "claude", "mode": "review", "input": ["plan.md", "test.txt"], "output": "review.md" },
    { "id": "revise", "pool": "codex", "mode": "execute", "when": "review.failed", "input": ["plan.md", "review.md", "test.txt"], "loopTo": "test" }
  ]
}
