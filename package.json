{
  "name": "multi-agent-workboard",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "start": "node tools/server.mjs",
    "usage": "node -e \"import('./tools/usage.mjs').then(m=>console.table(m.collectUsage(JSON.parse(require('fs').readFileSync('agents.json')).agents).map(({days,...r})=>r)))\"",
    "gate": "npm test && npm run test:e2e"
  }
}
